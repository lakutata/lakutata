{
  "name": "@lakutata/i18n",
  "version": "3.0.0",
  "description": "The internationalization of the lakutata framework: the messages of each language by their keys (ICU MessageFormat), the language of each request, the messages of the validation.",
  "keywords": [
    "lakutata",
    "i18n",
    "internationalization",
    "localization",
    "icu",
    "messageformat",
    "translation",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/i18n",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/i18n"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/I18n.js",
  "types": "./dist/cjs/exports/I18n.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/I18n.d.ts",
        "default": "./dist/esm/exports/I18n.js"
      },
      "require": {
        "types": "./dist/cjs/exports/I18n.d.ts",
        "default": "./dist/cjs/exports/I18n.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/types/exports/I18nMiddleware.d.ts",
        "default": "./dist/esm/exports/I18nMiddleware.js"
      },
      "require": {
        "types": "./dist/cjs/exports/I18nMiddleware.d.ts",
        "default": "./dist/cjs/exports/I18nMiddleware.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "peerDependencies": {
    "@lakutata/core": "3.0.0",
    "@lakutata/entrypoint": "3.0.0"
  },
  "peerDependenciesMeta": {
    "@lakutata/entrypoint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
