{
  "name": "@lakutata/i18n",
  "version": "2.0.126",
  "description": "The internationalization of the lakutata framework: the messages of each language by their keys (ICU MessageFormat), the language of each request, the messages of the validation.",
  "type": "module",
  "main": "./dist/cjs/exports/I18n.js",
  "types": "./dist/cjs/exports/I18n.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/I18n.d.ts",
        "default": "./dist/esm/exports/I18n.js"
      },
      "require": {
        "types": "./dist/cjs/exports/I18n.d.ts",
        "default": "./dist/cjs/exports/I18n.js"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/types/exports/I18nMiddleware.d.ts",
        "default": "./dist/esm/exports/I18nMiddleware.js"
      },
      "require": {
        "types": "./dist/cjs/exports/I18nMiddleware.d.ts",
        "default": "./dist/cjs/exports/I18nMiddleware.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "peerDependencies": {
    "@lakutata/core": "2.0.126",
    "@lakutata/entrypoint": "2.0.126"
  },
  "peerDependenciesMeta": {
    "@lakutata/entrypoint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
