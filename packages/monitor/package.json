{
  "name": "@lakutata/monitor",
  "version": "3.0.0-beta.2",
  "description": "The monitors of the lakutata framework: the CPU, the memory, the event loop and the HTTP requests of the process, on the histograms of Node.js.",
  "type": "module",
  "main": "./dist/cjs/exports/Monitor.js",
  "types": "./dist/cjs/exports/Monitor.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Monitor.d.ts",
        "default": "./dist/esm/exports/Monitor.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Monitor.d.ts",
        "default": "./dist/cjs/exports/Monitor.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "peerDependencies": {
    "@lakutata/core": "3.0.0-beta.2"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
