{
  "name": "@lakutata/containerd",
  "version": "3.1.0",
  "description": "The containerd component of the lakutata framework: images (pull, push, import, export, of any platform), containers and their processes, over the API of containerd, for the systems which run containerd without Docker.",
  "keywords": [
    "lakutata",
    "containerd",
    "containers",
    "images",
    "buildkit",
    "oci",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/containerd",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/containerd"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Containerd.js",
  "types": "./dist/cjs/exports/Containerd.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Containerd.d.ts",
        "default": "./dist/esm/exports/Containerd.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Containerd.d.ts",
        "default": "./dist/cjs/exports/Containerd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\"",
    "test:containerd": "npm run compile && CONTAINERD_TEST=1 node --test --test-concurrency=1 \"dist/esm/tests/engine/*.spec.js\"",
    "test:engines": "sh test-env/run.sh"
  },
  "dependencies": {
    "@lakutata/grpc": "3.1.0",
    "tar-stream": "3.2.2"
  },
  "peerDependencies": {
    "@lakutata/core": "3.1.0",
    "@lakutata/logger": "3.1.0",
    "@lakutata/utils": "3.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
