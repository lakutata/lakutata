{
  "name": "@lakutata/barcode",
  "version": "3.2.0",
  "description": "Barcodes and QR codes for lakutata: a component that generates them (PNG, SVG, pixels) and reads them from images, in a native addon built on zint and zxing-cpp; every format it writes, it reads back.",
  "keywords": [
    "lakutata",
    "barcode",
    "qrcode",
    "qr",
    "datamatrix",
    "pdf417",
    "aztec",
    "ean",
    "upc",
    "code128",
    "gs1",
    "scanner",
    "decoder",
    "generator",
    "zint",
    "zxing",
    "native",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/barcode",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/barcode"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Barcode.js",
  "types": "./dist/cjs/exports/Barcode.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Barcode.d.ts",
        "default": "./dist/esm/exports/Barcode.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Barcode.d.ts",
        "default": "./dist/cjs/exports/Barcode.js"
      }
    },
    "./package.json": "./package.json"
  },
  "gypfile": true,
  "scripts": {
    "install": "node-gyp rebuild -j max",
    "build:native": "node-gyp rebuild -j max",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:addon": "node scripts/addon.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg && npm run build:addon",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=120000 \"dist/esm/tests/**/*.spec.js\""
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "binding.gyp",
    "native",
    "vendor",
    "!vendor/UPSTREAM.json",
    "scripts/sources.mjs",
    "*.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "peerDependencies": {
    "@lakutata/core": "~3.2.0"
  }
}
