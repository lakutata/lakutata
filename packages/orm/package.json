{
  "name": "@lakutata/orm",
  "version": "3.0.0",
  "description": "The ORM of the lakutata framework, on TypeORM: the Database component and provider, the entity decorators and the generation of the migrations.",
  "keywords": [
    "lakutata",
    "typeorm",
    "orm",
    "database",
    "migrations",
    "postgresql",
    "mysql",
    "sqlite",
    "mongodb",
    "sql.js",
    "entity",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/orm",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/orm"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/ORM.js",
  "types": "./dist/cjs/exports/ORM.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/ORM.d.ts",
        "default": "./dist/esm/exports/ORM.js"
      },
      "require": {
        "types": "./dist/cjs/exports/ORM.d.ts",
        "default": "./dist/cjs/exports/ORM.js"
      }
    },
    "./decorator/orm": {
      "import": {
        "types": "./dist/types/exports/ORMDecorators.d.ts",
        "default": "./dist/esm/exports/ORMDecorators.js"
      },
      "require": {
        "types": "./dist/cjs/exports/ORMDecorators.d.ts",
        "default": "./dist/cjs/exports/ORMDecorators.js"
      }
    },
    "./com/database": {
      "import": {
        "types": "./dist/types/exports/DatabaseComponent.d.ts",
        "default": "./dist/esm/exports/DatabaseComponent.js"
      },
      "require": {
        "types": "./dist/cjs/exports/DatabaseComponent.d.ts",
        "default": "./dist/cjs/exports/DatabaseComponent.js"
      }
    },
    "./provider/database": {
      "import": {
        "types": "./dist/types/exports/DatabaseProvider.d.ts",
        "default": "./dist/esm/exports/DatabaseProvider.js"
      },
      "require": {
        "types": "./dist/cjs/exports/DatabaseProvider.d.ts",
        "default": "./dist/cjs/exports/DatabaseProvider.js"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#typeorm/*": "./dist/vendor/typeorm/*"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:typeorm": "tsc -p tsconfig.typeorm.json && node -e \"require('node:fs').writeFileSync('dist/vendor/typeorm/package.json', JSON.stringify({type: 'commonjs'}) + '\\\\n')\" && node scripts/embedded-worker.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:typeorm && npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\"",
    "test:integration": "npm run compile && node --test --test-concurrency=1 \"dist/esm/tests/integration/*.spec.js\""
  },
  "dependencies": {
    "@sqltools/formatter": "^1.2.5",
    "ansis": "4.4.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "dedent": "^1.7.2",
    "reflect-metadata": "0.2.2",
    "sql-highlight": "^6.1.0",
    "tinyglobby": "^0.2.17",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@google-cloud/spanner": "^8.0.0",
    "@lakutata/core": "3.0.0",
    "@lakutata/utils": "3.0.0",
    "@sap/hana-client": "^2.14.22",
    "better-sqlite3": "^12.0.0",
    "bson": "^7.0.0",
    "ioredis": "^5.0.4",
    "mingo": "^7.2.0",
    "mongodb": "^7.0.0",
    "mssql": "^12.0.0",
    "mysql2": "^3.15.3",
    "oracledb": "^6.3.0 || ^7.0.0",
    "pg": "^8.5.1",
    "pg-native": "^3.0.0",
    "pg-query-stream": "^4.0.0",
    "redis": "^5.0.0 || ^6.0.0",
    "sql.js": "^1.4.0",
    "typeorm-aurora-data-api-driver": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/spanner": {
      "optional": true
    },
    "@sap/hana-client": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "bson": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mingo": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-native": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "sql.js": {
      "optional": true
    },
    "typeorm-aurora-data-api-driver": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devDependencies": {
    "@types/debug": "4.1.13",
    "esbuild": "^0.28.2",
    "sql.js": "1.14.2"
  }
}
