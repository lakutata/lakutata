{
  "name": "@lakutata/entrypoint",
  "version": "2.0.126",
  "description": "The entrypoint component of the lakutata framework: controllers and the dispatch of the CLI, HTTP and service actions.",
  "type": "module",
  "main": "./dist/cjs/exports/Entrypoint.js",
  "types": "./dist/types/exports/Entrypoint.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/exports/Entrypoint.d.ts",
      "import": "./dist/esm/exports/Entrypoint.js",
      "require": "./dist/cjs/exports/Entrypoint.js"
    },
    "./decorator/ctrl": {
      "types": "./dist/types/exports/CTRLDecorators.d.ts",
      "import": "./dist/esm/exports/CTRLDecorators.js",
      "require": "./dist/cjs/exports/CTRLDecorators.js"
    },
    "./channel": {
      "types": "./dist/types/exports/Channel.d.ts",
      "import": "./dist/esm/exports/Channel.js",
      "require": "./dist/cjs/exports/Channel.js"
    },
    "./adapter/express": {
      "types": "./dist/types/exports/ExpressAdapter.d.ts",
      "import": "./dist/esm/exports/ExpressAdapter.js",
      "require": "./dist/cjs/exports/ExpressAdapter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "patrun": "7.2.7"
  },
  "peerDependencies": {
    "@lakutata/core": "2.0.126",
    "express": "^4.21.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.20.4",
    "express": "^5.2.1",
    "shx": "0.3.4",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
