{
  "name": "@lakutata/entrypoint",
  "version": "2.0.126",
  "description": "The entrypoint component of the lakutata framework: controllers and the dispatch of the CLI, HTTP and service actions.",
  "type": "module",
  "main": "./dist/cjs/exports/Entrypoint.js",
  "types": "./dist/cjs/exports/Entrypoint.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Entrypoint.d.ts",
        "default": "./dist/esm/exports/Entrypoint.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Entrypoint.d.ts",
        "default": "./dist/cjs/exports/Entrypoint.js"
      }
    },
    "./decorator/ctrl": {
      "import": {
        "types": "./dist/types/exports/CTRLDecorators.d.ts",
        "default": "./dist/esm/exports/CTRLDecorators.js"
      },
      "require": {
        "types": "./dist/cjs/exports/CTRLDecorators.d.ts",
        "default": "./dist/cjs/exports/CTRLDecorators.js"
      }
    },
    "./channel": {
      "import": {
        "types": "./dist/types/exports/Channel.d.ts",
        "default": "./dist/esm/exports/Channel.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Channel.d.ts",
        "default": "./dist/cjs/exports/Channel.js"
      }
    },
    "./adapter/express": {
      "import": {
        "types": "./dist/types/exports/ExpressAdapter.d.ts",
        "default": "./dist/esm/exports/ExpressAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/exports/ExpressAdapter.d.ts",
        "default": "./dist/cjs/exports/ExpressAdapter.js"
      }
    },
    "./adapter/commander": {
      "import": {
        "types": "./dist/types/exports/CommanderAdapter.d.ts",
        "default": "./dist/esm/exports/CommanderAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/exports/CommanderAdapter.d.ts",
        "default": "./dist/cjs/exports/CommanderAdapter.js"
      }
    },
    "./adapter/fastify": {
      "import": {
        "types": "./dist/types/exports/FastifyAdapter.d.ts",
        "default": "./dist/esm/exports/FastifyAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/exports/FastifyAdapter.d.ts",
        "default": "./dist/cjs/exports/FastifyAdapter.js"
      }
    },
    "./adapter/socket.io": {
      "import": {
        "types": "./dist/types/exports/SocketIOAdapter.d.ts",
        "default": "./dist/esm/exports/SocketIOAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/exports/SocketIOAdapter.d.ts",
        "default": "./dist/cjs/exports/SocketIOAdapter.js"
      }
    },
    "./adapter/electron": {
      "import": {
        "types": "./dist/types/exports/ElectronAdapter.d.ts",
        "default": "./dist/esm/exports/ElectronAdapter.js"
      },
      "require": {
        "types": "./dist/cjs/exports/ElectronAdapter.d.ts",
        "default": "./dist/cjs/exports/ElectronAdapter.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "patrun": "7.2.7"
  },
  "peerDependencies": {
    "@inquirer/prompts": "^7.0.0 || ^8.0.0",
    "@lakutata/core": "2.0.126",
    "commander": "^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0",
    "express": "^4.21.0 || ^5.0.0",
    "fastify": "^5.0.0",
    "socket.io": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "@inquirer/prompts": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@types/express": "^5.0.6",
    "@types/node": "22.20.4",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "shx": "0.3.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
