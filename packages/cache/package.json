{
  "name": "@lakutata/cache",
  "version": "3.0.0-beta.0",
  "description": "The cache component of the lakutata framework (memory, file, Redis, Memcache, MongoDB, SQLite, PostgreSQL, MySQL stores).",
  "type": "module",
  "main": "./dist/cjs/exports/Cache.js",
  "types": "./dist/cjs/exports/Cache.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Cache.d.ts",
        "default": "./dist/esm/exports/Cache.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Cache.d.ts",
        "default": "./dist/cjs/exports/Cache.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\"",
    "test:stores": "npm run compile && CACHE_TEST_STORES=1 node --test --test-concurrency=1 \"dist/esm/tests/stores/*.spec.js\""
  },
  "peerDependencies": {
    "@lakutata/core": "3.0.0-beta.0",
    "@lakutata/utils": "3.0.0-beta.0",
    "memjs": "^1.3.2",
    "mongodb": ">=6.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "redis": "^4.6.0 || ^5.0.0",
    "sqlite3": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "memjs": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
