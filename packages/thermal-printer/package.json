{
  "name": "@lakutata/thermal-printer",
  "version": "3.2.0",
  "description": "Thermal printers for lakutata: a component that renders receipts, labels and wristbands written in HTML (by @lakutata/thermal), encodes them as ESC/POS, TSPL or ZPL, and sends them to the printers by the network, the system print queue, a serial port, USB or Bluetooth, one queue of jobs per printer.",
  "keywords": [
    "lakutata",
    "thermal",
    "printer",
    "receipt",
    "label",
    "wristband",
    "escpos",
    "esc-pos",
    "tspl",
    "zpl",
    "pos",
    "cups",
    "raw",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/thermal-printer",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/thermal-printer"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/ThermalPrinter.js",
  "types": "./dist/cjs/exports/ThermalPrinter.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/ThermalPrinter.d.ts",
        "default": "./dist/esm/exports/ThermalPrinter.js"
      },
      "require": {
        "types": "./dist/cjs/exports/ThermalPrinter.d.ts",
        "default": "./dist/cjs/exports/ThermalPrinter.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=120000 \"dist/esm/tests/**/*.spec.js\""
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@lakutata/thermal": "~3.2.0"
  },
  "peerDependencies": {
    "@lakutata/core": "~3.2.0",
    "@lakutata/serial": "~3.2.0",
    "@lakutata/usb": "~3.2.0",
    "@lakutata/bluetooth": "~3.2.0"
  },
  "peerDependenciesMeta": {
    "@lakutata/serial": {
      "optional": true
    },
    "@lakutata/usb": {
      "optional": true
    },
    "@lakutata/bluetooth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lakutata/serial": "~3.2.0"
  }
}
