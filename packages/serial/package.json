{
  "name": "@lakutata/serial",
  "version": "3.2.0",
  "description": "Serial ports for Node.js: a port opened as a stream (its speed, data bits, parity, stop bits and flow control set), its modem lines, and the listing of the ports with their USB ids, by a small native addon (termios on Linux and macOS, the communications API on Windows).",
  "keywords": [
    "lakutata",
    "serial",
    "serialport",
    "serial-port",
    "uart",
    "rs232",
    "com",
    "tty",
    "termios",
    "usb-serial",
    "printer",
    "native",
    "addon",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/serial",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/serial"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Serial.js",
  "types": "./dist/cjs/exports/Serial.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Serial.d.ts",
        "default": "./dist/esm/exports/Serial.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Serial.d.ts",
        "default": "./dist/cjs/exports/Serial.js"
      }
    },
    "./package.json": "./package.json"
  },
  "gypfile": true,
  "scripts": {
    "install": "node-gyp rebuild",
    "build:native": "node-gyp rebuild",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:addon": "node scripts/addon.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg && npm run build:addon",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=120000 \"dist/esm/tests/**/*.spec.js\""
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "binding.gyp",
    "native",
    "scripts/addon.mjs",
    "*.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "peerDependencies": {
    "@lakutata/core": "~3.2.0"
  }
}
