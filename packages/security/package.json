{
  "name": "@lakutata/security",
  "version": "3.1.0",
  "description": "Security providers and functions of the lakutata framework (password hashing, signatures, encryption).",
  "keywords": [
    "lakutata",
    "security",
    "password-hashing",
    "bcrypt",
    "hmac",
    "aes-gcm",
    "encryption",
    "crypto",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/security",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/security"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Security.js",
  "types": "./dist/cjs/exports/Security.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Security.d.ts",
        "default": "./dist/esm/exports/Security.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Security.d.ts",
        "default": "./dist/cjs/exports/Security.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "peerDependencies": {
    "@lakutata/core": "3.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
