{
  "name": "@lakutata/cacher",
  "version": "2.0.126",
  "description": "The cache component of the lakutata framework (memory, file, Redis, Memcache, MongoDB, SQLite, PostgreSQL, MySQL stores).",
  "type": "module",
  "main": "./dist/cjs/exports/Cacher.js",
  "types": "./dist/types/exports/Cacher.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/exports/Cacher.d.ts",
      "import": "./dist/esm/exports/Cacher.js",
      "require": "./dist/cjs/exports/Cacher.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "cache-manager": "7.2.5",
    "keyv": "^5.0.0",
    "keyv-file": "5.3.3"
  },
  "peerDependencies": {
    "@lakutata/core": "2.0.126"
  },
  "devDependencies": {
    "@keyv/memcache": "2.0.2",
    "@keyv/mongo": "3.0.5",
    "@keyv/mysql": "2.1.9",
    "@keyv/postgres": "2.2.2",
    "@keyv/redis": "4.6.0",
    "@keyv/sqlite": "4.0.6",
    "@types/node": "22.20.4",
    "shx": "0.3.4",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
