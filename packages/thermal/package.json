{
  "name": "@lakutata/thermal",
  "version": "3.2.0",
  "description": "Thermal printing for Node.js: receipts, labels and wristbands written in HTML and CSS, rendered by a native addon (litehtml, FreeType, plutovg, lunasvg) into the printer's 1-bit dot grid, the same picture as the preview, then encoded as ESC/POS, TSPL or ZPL commands.",
  "keywords": [
    "lakutata",
    "thermal",
    "printer",
    "receipt",
    "label",
    "wristband",
    "escpos",
    "esc-pos",
    "tspl",
    "zpl",
    "pos",
    "html",
    "css",
    "raster",
    "litehtml",
    "native",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/thermal",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/thermal"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Thermal.js",
  "types": "./dist/cjs/exports/Thermal.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Thermal.d.ts",
        "default": "./dist/esm/exports/Thermal.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Thermal.d.ts",
        "default": "./dist/cjs/exports/Thermal.js"
      }
    },
    "./package.json": "./package.json"
  },
  "gypfile": true,
  "scripts": {
    "install": "node-gyp rebuild -j max",
    "build:native": "node-gyp rebuild -j max",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:addon": "node scripts/addon.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg && npm run build:addon",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=120000 \"dist/esm/tests/**/*.spec.js\""
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "binding.gyp",
    "native",
    "vendor",
    "!vendor/UPSTREAM.json",
    "scripts/sources.mjs",
    "*.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "peerDependencies": {
    "@lakutata/core": "~3.2.0"
  }
}
