{
  "name": "{$APP_ID}-workspace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lakutata run rebuild",
    "test": "npm run build && lakutata run test",
    "dev": "lakutata run dev --parallel",
    "migration:generate": "lakutata migration generate --package app",
    "migration:create": "lakutata migration create --package app",
    "migration:run": "lakutata migration run --package app",
    "migration:revert": "lakutata migration revert --package app",
    "migration:show": "lakutata migration show --package app",
    "start": "npm start -w app",
    "version:patch": "lakutata version patch --yes",
    "docker:build": "docker buildx build --tag {$APP_ID}:$npm_package_version --load .",
    "docker:push": "docker buildx build --platform linux/amd64 --tag $DOCKER_REPOSITORY:$npm_package_version --tag $DOCKER_REPOSITORY:latest --push ."
  },
  "devDependencies": {
    "@lakutata/cli": "^{$LAKUTATA_VERSION}",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  }
}
