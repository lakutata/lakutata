{
  "name": "@lakutata/ffi",
  "version": "3.1.1",
  "description": "Native libraries for the lakutata framework: C functions of .so, .dylib and .dll files called from Node.js, Electron and Bun, declared with the C declarations of their headers, a library being a component of the application.",
  "keywords": [
    "lakutata",
    "ffi",
    "native",
    "c",
    "dll",
    "shared-library",
    "dlopen",
    "koffi",
    "bindings",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/ffi",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/ffi"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/FFI.js",
  "types": "./dist/cjs/exports/FFI.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/FFI.d.ts",
        "default": "./dist/esm/exports/FFI.js"
      },
      "require": {
        "types": "./dist/cjs/exports/FFI.d.ts",
        "default": "./dist/cjs/exports/FFI.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg && npm run build:worker",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=60000 \"dist/esm/tests/**/*.spec.js\"",
    "test:bun": "sh test-env/bun.sh",
    "test:electron": "electron test-env/electron/main.mjs",
    "build:worker": "node scripts/worker.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ],
  "peerDependencies": {
    "@lakutata/core": "3.1.1"
  },
  "dependencies": {
    "koffi": "3.3.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
