{
  "name": "@lakutata/mutex",
  "version": "2.0.126",
  "description": "The locks of the lakutata framework: mutual exclusion between the instances and the processes of an application, over memory, files, Redis, PostgreSQL or MySQL, held by tokens, renewed while they are held.",
  "type": "module",
  "main": "./dist/cjs/exports/Mutex.js",
  "types": "./dist/cjs/exports/Mutex.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Mutex.d.ts",
        "default": "./dist/esm/exports/Mutex.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Mutex.d.ts",
        "default": "./dist/cjs/exports/Mutex.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-concurrency=1 \"dist/esm/tests/*.spec.js\"",
    "test:stores": "sh test-env/run.sh"
  },
  "peerDependencies": {
    "@lakutata/core": "2.0.126",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "redis": "^4.6.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
