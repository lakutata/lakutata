{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ESNext.Disposable"
    ],
    "declaration": true,
    "moduleDetection": "auto",
    "module": "Node16",
    "rootDir": "src",
    "moduleResolution": "Node16",
    "allowSyntheticDefaultImports": true,
    "types": [
      "reflect-metadata",
      "node"
    ],
    "jsx": "react",
    "useDefineForClassFields": false,
    "preserveConstEnums": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "distro/src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "isolatedModules": true,
    "declarationMap": true,
    "paths": {
      "@lakutata/core": [
        "../core/dist/types/exports/Core"
      ],
      "@lakutata/core/decorator/di": [
        "../core/dist/types/exports/DIDecorators"
      ],
      "@lakutata/ldap-engine": [
        "../ldap-engine/dist/types/exports/LDAPEngine"
      ],
      "@lakutata/netif": [
        "../netif/dist/types/exports/Netif"
      ],
      "@lakutata/orm": [
        "../orm/dist/types/exports/ORM"
      ],
      "@lakutata/orm/decorator/orm": [
        "../orm/dist/types/exports/ORMDecorators"
      ],
      "@lakutata/orm/com/database": [
        "../orm/dist/types/exports/DatabaseComponent"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "test-env",
    "scripts",
    "build",
    "distro",
    "publish.mjs",
    "rollup.mjs",
    "dist"
  ]
}
