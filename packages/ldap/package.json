{
  "name": "@lakutata/ldap",
  "version": "3.2.1",
  "description": "LDAP for lakutata applications: a server component (backends, interceptors, the schema, access control, StartTLS and LDAPS, listening on network interfaces) and a client component, on the engine @lakutata/ldap-engine, which it re-exports.",
  "keywords": [
    "lakutata",
    "ldap",
    "ldap-client",
    "ldap-server",
    "directory",
    "active-directory",
    "openldap",
    "authentication",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/ldap",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/ldap"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/LDAP.js",
  "types": "./dist/cjs/exports/LDAP.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/LDAP.d.ts",
        "default": "./dist/esm/exports/LDAP.js"
      },
      "require": {
        "types": "./dist/cjs/exports/LDAP.d.ts",
        "default": "./dist/cjs/exports/LDAP.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=60000 \"dist/esm/tests/**/*.spec.js\""
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ],
  "dependencies": {
    "@lakutata/ldap-engine": "3.2.1"
  },
  "peerDependencies": {
    "@lakutata/core": "~3.2.0",
    "@lakutata/netif": "~3.2.0"
  },
  "peerDependenciesMeta": {
    "@lakutata/netif": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lakutata/netif": "~3.2.0"
  }
}
