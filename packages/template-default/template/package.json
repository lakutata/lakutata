    "test": "npm run build && node --test \"build/tests/**/*.spec.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "lakutata": "^{$LAKUTATA_VERSION}"
  },
  "devDependencies": {
    "@lakutata/cli": "^{$LAKUTATA_VERSION}",
    "@types/express": "^5.0.6",
