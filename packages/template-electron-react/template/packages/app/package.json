{
  "name": "app",
  "productName": "{$APP_NAME}",
  "version": "0.0.1",
  "description": "{$APP_DESC}",
  "author": "{$APP_AUTHOR}",
  "license": "{$APP_LICENSE}",
  "private": true,
  "type": "module",
  "main": "build/App.js",
  "scripts": {
    "clean": "lakutata clean",
    "build": "tsc",
    "rebuild": "npm run clean && npm run build",
    "dev": "npm run rebuild && electron build/App.js --renderer=http://localhost:5173",
    "start": "electron build/App.js",
    "test": "node --test \"build/tests/**/*.spec.js\"",
    "package": "lakutata package installer"
  },
  "dependencies": {
    "lakutata": "^{$LAKUTATA_VERSION}",
    "ui": "^0.0.1",
    "resources": "^0.0.1",
    "socket.io": "^4.8.4"
  },
  "lakutata": {
    "icon": "../resources/logo.png",
    "resources": [
      {
        "from": "../ui/dist",
        "to": "renderer"
      },
      {
        "from": "build/preload.cjs",
        "to": "preload.cjs"
      },
      {
        "from": "../resources/logo.png",
        "to": "logo.png"
      }
    ],
    "installer": {
      "runtime": "electron",
      "name": "{$APP_ID}",
      "appId": "{$APP_ID}",
      "linux": {
        "targets": [
          "deb"
        ]
      },
      "mac": {
        "targets": [
          "dmg"
        ]
      },
      "win": {
        "targets": [
          "nsis",
          "portable"
        ]
      },
      "electron": {
        "linux": {
          "category": "Utility",
          "syncDesktopName": true
        },
        "deb": {
          "depends": [
            "libgtk-3-0",
            "libnotify4",
            "libnss3",
            "libxss1",
            "libxtst6",
            "xdg-utils",
            "libatspi2.0-0",
            "libuuid1",
            "libsecret-1-0",
            "libasound2"
          ]
        }
      }
    }
  }
}
