{
  "bin": {
    "{$APP_ID}": "build/App.js"
  },
  "scripts": {
    "package": "lakutata package installer"
  },
  "lakutata": {
    "installer": {
      "name": "{$APP_ID}",
      "service": {
        "env": {
          "PORT": "8080"
        }
      },
      "linux": {
        "targets": [
          "deb",
          "rpm",
          "tar.gz"
        ]
      }
    }
  }
}
