{
  "name": "@lakutata/docker",
  "version": "3.1.5",
  "description": "The Docker component of the lakutata framework: images (pull, build with BuildKit, import, export, push), containers, their TTYs and networks, over the Docker Engine API.",
  "keywords": [
    "lakutata",
    "docker",
    "docker-engine-api",
    "containers",
    "images",
    "buildkit",
    "ssh",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/docker",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/docker"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Docker.js",
  "types": "./dist/cjs/exports/Docker.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Docker.d.ts",
        "default": "./dist/esm/exports/Docker.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Docker.d.ts",
        "default": "./dist/cjs/exports/Docker.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\"",
    "test:docker": "npm run compile && DOCKER_TEST=1 node --test --test-concurrency=1 \"dist/esm/tests/engine/*.spec.js\""
  },
  "dependencies": {
    "tar-stream": "3.2.2"
  },
  "peerDependencies": {
    "@lakutata/core": "~3.1.5",
    "@lakutata/logger": "~3.1.5",
    "@lakutata/utils": "~3.1.5",
    "ssh2": "^1.15.0"
  },
  "peerDependenciesMeta": {
    "ssh2": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
