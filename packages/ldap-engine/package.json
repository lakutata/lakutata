{
  "name": "@lakutata/ldap-engine",
  "version": "3.2.2",
  "description": "LDAP for Node.js in TypeScript without native code: the protocol (messages, controls, DNs, filters, schemas, LDIF), a client and a server engine, with no dependencies. The lakutata components are in @lakutata/ldap.",
  "keywords": [
    "lakutata",
    "ldap",
    "ldap-client",
    "ldap-server",
    "ldaps",
    "starttls",
    "directory",
    "active-directory",
    "openldap",
    "ldif",
    "ber",
    "asn1",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/ldap-engine",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/ldap-engine"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/LDAPEngine.js",
  "types": "./dist/cjs/exports/LDAPEngine.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/LDAPEngine.d.ts",
        "default": "./dist/esm/exports/LDAPEngine.js"
      },
      "require": {
        "types": "./dist/cjs/exports/LDAPEngine.d.ts",
        "default": "./dist/cjs/exports/LDAPEngine.js"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/types/exports/Schemas.d.ts",
        "default": "./dist/esm/exports/Schemas.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Schemas.d.ts",
        "default": "./dist/cjs/exports/Schemas.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=60000 \"dist/esm/tests/**/*.spec.js\"",
    "test:fuzz": "npm run compile && node dist/esm/tests/support/FuzzRunner.js --iterations 200000",
    "test:openldap": "npm run compile && sh test-env/openldap/run.sh && sh test-env/openldap/tools.sh",
    "test:bun": "npm run compile && sh test-env/bun.sh",
    "test:electron": "npm run compile && electron test-env/electron/main.mjs"
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
