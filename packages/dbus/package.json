{
  "name": "@lakutata/dbus",
  "version": "2.0.126",
  "description": "The DBus channel of the lakutata framework: controller actions served as the methods, properties and signals of DBus objects, and the DBus client component.",
  "type": "module",
  "main": "./dist/cjs/exports/DBus.js",
  "types": "./dist/types/exports/DBus.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/exports/DBus.d.ts",
      "import": "./dist/esm/exports/DBus.js",
      "require": "./dist/cjs/exports/DBus.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "dbus-sdk": "^1.0.16"
  },
  "peerDependencies": {
    "@lakutata/core": "2.0.126",
    "@lakutata/entrypoint": "2.0.126"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "shx": "0.3.4",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT"
}
