{
  "name": "@lakutata/dbus",
  "version": "3.0.0",
  "description": "The DBus channel of the lakutata framework: controller actions served as the methods, properties and signals of DBus objects, and the DBus client component.",
  "type": "module",
  "main": "./dist/cjs/exports/DBus.js",
  "types": "./dist/cjs/exports/DBus.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/DBus.d.ts",
        "default": "./dist/esm/exports/DBus.js"
      },
      "require": {
        "types": "./dist/cjs/exports/DBus.d.ts",
        "default": "./dist/cjs/exports/DBus.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "dbus-sdk": "^2.0.1"
  },
  "peerDependencies": {
    "@lakutata/core": "3.0.0",
    "@lakutata/entrypoint": "3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT"
}
