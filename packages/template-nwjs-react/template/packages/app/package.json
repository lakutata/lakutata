{
  "name": "app",
  "productName": "{$APP_NAME}",
  "version": "0.0.1",
  "description": "{$APP_DESC}",
  "author": "{$APP_AUTHOR}",
  "license": "{$APP_LICENSE}",
  "private": true,
  "type": "module",
  "main": "build/App.js",
  "scripts": {
    "clean": "lakutata clean",
    "build": "tsc",
    "rebuild": "npm run clean && npm run build",
    "dev": "npm run rebuild && lakutata nwjs run -- --ui=http://localhost:5173",
    "start": "lakutata nwjs run",
    "test": "node --test \"build/tests/**/*.spec.js\"",
    "package": "lakutata package installer"
  },
  "dependencies": {
    "lakutata": "^{$LAKUTATA_VERSION}",
    "ui": "^0.0.1",
    "resources": "^0.0.1"
  },
  "lakutata": {
    "icon": "../resources/logo.png",
    "nwjs": {
      "version": "0.119.2"
    },
    "resources": [
      {
        "from": "../ui/dist",
        "to": "ui"
      },
      {
        "from": "host",
        "to": "host"
      },
      {
        "from": "../resources/logo.png",
        "to": "logo.png"
      }
    ],
    "installer": {
      "runtime": "nwjs",
      "name": "{$APP_ID}",
      "appId": "{$APP_ID}",
      "linux": {
        "targets": [
          "deb"
        ]
      },
      "mac": {
        "targets": [
          "dmg"
        ]
      },
      "win": {
        "targets": [
          "nsis",
          "zip"
        ]
      }
    }
  }
}
