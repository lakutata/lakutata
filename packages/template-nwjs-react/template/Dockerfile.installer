# The installers of Linux (npm run package:linux), made on Linux: the packages of the configuration (lakutata.installer
# of packages/app/package.json) in dist/installer. The ones of another architecture: docker buildx build --platform
# linux/amd64 ... The runtimes of NW.js are kept in a cache of the builds; add the system libraries your native addons need
FROM node:22-bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /project
COPY . .
RUN --mount=type=cache,target=/root/.cache/lakutata \
    (npm ci --no-audit --no-fund || npm install --no-audit --no-fund) && npm run build && npm run package -w app -- --outdir /installer

FROM scratch
COPY --from=build /installer /
