{
  "name": "@lakutata/mcp",
  "version": "3.1.1",
  "description": "The MCP channel of the lakutata framework: controller actions served as the tools of a Model Context Protocol server, over stdio or HTTP.",
  "keywords": [
    "lakutata",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "agent",
    "tools",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/mcp",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/mcp"
  },
  "author": "alex.ma",
  "type": "module",
  "main": "./dist/cjs/exports/MCP.js",
  "types": "./dist/cjs/exports/MCP.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/MCP.d.ts",
        "default": "./dist/esm/exports/MCP.js"
      },
      "require": {
        "types": "./dist/cjs/exports/MCP.d.ts",
        "default": "./dist/cjs/exports/MCP.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0"
  },
  "peerDependencies": {
    "@lakutata/core": "3.1.1",
    "@lakutata/entrypoint": "3.1.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT"
}
