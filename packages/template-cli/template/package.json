{
  "name": "{$APP_ID}-workspace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lakutata run rebuild",
    "test": "lakutata run test",
    "start": "npm start -w app",
    "package:bundle": "npm run build && npm run package:bundle -w app -- --outfile ../../dist/{$APP_ID}.cjs",
    "package:exe": "npm run build && npm run package:exe -w app -- --outdir ../../dist",
    "version:patch": "lakutata version patch --yes"
  },
  "devDependencies": {
    "@lakutata/builder": "^{$LAKUTATA_VERSION}",
    "@lakutata/cli": "^{$LAKUTATA_VERSION}",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
