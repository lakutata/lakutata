{
  "name": "{$APP_ID}",
  "version": "0.0.1",
  "description": "{$APP_DESC}",
  "author": "{$APP_AUTHOR}",
  "license": "{$APP_LICENSE}",
  "private": true,
  "type": "module",
  "main": "build/App.js",
  "bin": {
    "{$APP_ID}": "build/App.js"
  },
  "files": [
    "build",
    "!build/tests"
  ],
  "scripts": {
    "clean": "node -e \"for (const d of ['build', 'dist']) require('node:fs').rmSync(d, {recursive: true, force: true})\"",
    "compile": "npm run clean && tsc",
    "start": "node build/App.js",
    "test": "npm run compile && node --test \"build/tests/**/*.spec.js\"",
    "build": "npm run compile && lakutata executable",
    "bundle": "npm run compile && lakutata bundle"
  },

  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "lakutata": "^{$LAKUTATA_VERSION}"
  },
  "devDependencies": {
    "@lakutata/cli": "^{$LAKUTATA_VERSION}",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
