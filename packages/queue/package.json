{
  "name": "@lakutata/queue",
  "version": "3.1.4",
  "description": "The message queues of the lakutata framework: messages added by the Queue component and processed by controller actions (@QueueAction), acknowledged, retried and dead-lettered alike over memory, Redis, NATS JetStream, Kafka or RabbitMQ.",
  "keywords": [
    "lakutata",
    "queue",
    "message-queue",
    "bullmq",
    "redis",
    "nats",
    "jetstream",
    "rabbitmq",
    "amqp",
    "kafka",
    "dead-letter",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/queue",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/queue"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Queue.js",
  "types": "./dist/cjs/exports/Queue.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Queue.d.ts",
        "default": "./dist/esm/exports/Queue.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Queue.d.ts",
        "default": "./dist/cjs/exports/Queue.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=60000 \"dist/esm/tests/*.spec.js\"",
    "test:servers": "sh test-env/run.sh"
  },
  "peerDependencies": {
    "@lakutata/core": "~3.1.4",
    "@lakutata/entrypoint": "~3.1.4",
    "@lakutata/utils": "~3.1.1",
    "@platformatic/kafka": "^2.14.0",
    "amqplib": "^2.2.0",
    "bullmq": "^6.3.15",
    "ioredis": "^5.0.0",
    "nats": "^2.29.3"
  },
  "peerDependenciesMeta": {
    "@platformatic/kafka": {
      "optional": true
    },
    "amqplib": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "nats": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ],
  "devDependencies": {
    "@platformatic/kafka": "^2.14.0",
    "amqplib": "^2.2.0",
    "bullmq": "^6.3.15",
    "ioredis": "^5.11.1",
    "nats": "^2.29.3"
  }
}
