{
  "name": "@lakutata/webrtc",
  "version": "3.1.4",
  "description": "WebRTC for the lakutata framework, in TypeScript without native code: the signaling, a STUN/TURN server, a media server (SFU) for rooms of many members, WHIP publishing and WHEP playback, peer connections with data channels and audio and video tracks in Node.js, Electron and Bun, the service actions of an application called through data channels, and a browser client.",
  "keywords": [
    "lakutata",
    "webrtc",
    "datachannel",
    "signaling",
    "turn",
    "stun",
    "ice",
    "sctp",
    "dtls",
    "srtp",
    "rtp",
    "whip",
    "whep",
    "sfu",
    "media-server",
    "json-rpc",
    "peer-to-peer",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/webrtc",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/webrtc"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/WebRTC.js",
  "types": "./dist/cjs/exports/WebRTC.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/WebRTC.d.ts",
        "default": "./dist/esm/exports/WebRTC.js"
      },
      "require": {
        "types": "./dist/cjs/exports/WebRTC.d.ts",
        "default": "./dist/cjs/exports/WebRTC.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/types/exports/Client.d.ts",
        "default": "./dist/esm/exports/Client.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Client.d.ts",
        "default": "./dist/cjs/exports/Client.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:worker": "node scripts/workers.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg && npm run build:worker",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test --test-timeout=60000 \"dist/esm/tests/**/*.spec.js\"",
    "test:servers": "sh test-env/cluster.sh",
    "test:interop": "sh test-env/interop/run.sh",
    "test:linux": "sh test-env/linux.sh",
    "test:bun": "sh test-env/bun.sh",
    "test:electron": "electron test-env/electron/main.mjs"
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "peerDependencies": {
    "@lakutata/core": "~3.1.4",
    "@lakutata/entrypoint": "~3.1.4",
    "ioredis": "^5.0.0",
    "nats": "^2.29.3",
    "socket.io-client": "^4.0.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@lakutata/core": {
      "optional": true
    },
    "@lakutata/entrypoint": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "nats": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
