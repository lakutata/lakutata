{
  "name": "@lakutata/cli",
  "version": "3.1.4",
  "description": "The command line tool of the lakutata framework: create the projects from the templates, run and version the packages of the workspaces, bundle the applications and make their executables (with @lakutata/builder).",
  "keywords": [
    "lakutata",
    "cli",
    "scaffolding",
    "templates",
    "monorepo",
    "workspaces",
    "bundle",
    "executable",
    "installer",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/cli",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/cli"
  },
  "author": "alex.ma",
  "type": "module",
  "bin": {
    "lakutata": "./dist/esm/CLIApp.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:js": "tsc -p tsconfig.esm.json && node -e \"require('node:fs').chmodSync('dist/esm/CLIApp.js',0o755)\"",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --import ./dist/esm/tests/support/English.js --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "lakutata": "3.1.4"
  },
  "peerDependencies": {
    "@lakutata/builder": "~3.1.3",
    "@lakutata/ffi": "~3.1.2"
  },
  "peerDependenciesMeta": {
    "@lakutata/builder": {
      "optional": true
    },
    "@lakutata/ffi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lakutata/builder": "~3.1.3",
    "@lakutata/ffi": "~3.1.2"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "license": "MIT",
  "files": [
    "dist/esm",
    "!dist/esm/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
