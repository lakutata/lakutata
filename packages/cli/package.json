{
  "name": "@lakutata/cli",
  "version": "3.0.0-beta.6",
  "description": "The command line tool of the lakutata framework: create the projects from the templates, run and version the packages of the workspaces, bundle the applications and make their executables (with @lakutata/builder).",
  "type": "module",
  "bin": {
    "lakutata": "./dist/esm/CLIApp.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:js": "tsc -p tsconfig.esm.json && node -e \"require('node:fs').chmodSync('dist/esm/CLIApp.js',0o755)\"",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --import ./dist/esm/tests/support/English.js --test \"dist/esm/tests/*.spec.js\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "lakutata": "3.0.0-beta.6"
  },
  "peerDependencies": {
    "@lakutata/builder": "3.0.0-beta.6"
  },
  "peerDependenciesMeta": {
    "@lakutata/builder": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lakutata/builder": "3.0.0-beta.6"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "files": [
    "dist/esm",
    "!dist/esm/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
