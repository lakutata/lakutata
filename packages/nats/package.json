{
  "name": "@lakutata/nats",
  "version": "3.0.0-beta.1",
  "description": "The NATS component of the lakutata framework: messaging, service proxies, service entrypoint and large payloads.",
  "type": "module",
  "main": "./dist/cjs/exports/Nats.js",
  "types": "./dist/cjs/exports/Nats.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Nats.d.ts",
        "default": "./dist/esm/exports/Nats.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Nats.d.ts",
        "default": "./dist/cjs/exports/Nats.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/unit/*.spec.js\"",
    "test:integration": "npm run compile && node --test --test-concurrency=1 \"dist/esm/tests/integration/*.spec.js\""
  },
  "dependencies": {
    "nats": "^2.29.3"
  },
  "peerDependencies": {
    "@lakutata/core": "3.0.0-beta.1",
    "@lakutata/entrypoint": "3.0.0-beta.1",
    "@lakutata/utils": "3.0.0-beta.1"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
