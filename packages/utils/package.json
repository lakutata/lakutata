{
  "name": "@lakutata/utils",
  "version": "2.0.126",
  "description": "Utilities of the lakutata framework (Time).",
  "type": "module",
  "main": "./dist/cjs/exports/Utils.js",
  "types": "./dist/cjs/exports/Utils.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Utils.d.ts",
        "default": "./dist/esm/exports/Utils.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Utils.d.ts",
        "default": "./dist/cjs/exports/Utils.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json"
  ]
}
