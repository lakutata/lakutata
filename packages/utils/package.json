{
  "name": "@lakutata/utils",
  "version": "3.1.1",
  "description": "The utilities of the lakutata framework: Time (dates in IANA time zones) and the helpers for strings, objects, hashes, encodings, UUIDs, IP addresses and globs.",
  "keywords": [
    "lakutata",
    "utils",
    "helpers",
    "time",
    "timezone",
    "uuid",
    "glob",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/utils",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/utils"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Utils.js",
  "types": "./dist/cjs/exports/Utils.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Utils.d.ts",
        "default": "./dist/esm/exports/Utils.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Utils.d.ts",
        "default": "./dist/cjs/exports/Utils.js"
      }
    },
    "./Time": {
      "import": {
        "types": "./dist/types/lib/Time.d.ts",
        "default": "./dist/esm/lib/Time.js"
      },
      "require": {
        "types": "./dist/cjs/lib/Time.d.ts",
        "default": "./dist/cjs/lib/Time.js"
      }
    },
    "./internal/*": null,
    "./*": {
      "import": {
        "types": "./dist/types/lib/helpers/*.d.ts",
        "default": "./dist/esm/lib/helpers/*.js"
      },
      "require": {
        "types": "./dist/cjs/lib/helpers/*.d.ts",
        "default": "./dist/cjs/lib/helpers/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
