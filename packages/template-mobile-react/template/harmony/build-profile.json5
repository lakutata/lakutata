{
  app: {
    products: [
      {
        name: 'default',
        compatibleSdkVersion: '5.0.0(12)',
        targetSdkVersion: '26.0.0',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          nativeCompiler: 'BiSheng'
        }
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
    signingConfigs: [],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: ['default'],
        },
      ],
    },
  ],
}
