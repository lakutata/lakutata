#!/bin/sh
# xcrun on Linux: the SDKs of iOS copied into /build/sdk, the host (macosx) is the Linux system
sdk=""; item=""
while [ $# -gt 0 ]; do
  case "$1" in
    --sdk|-sdk) sdk="$2"; shift 2 ;;
    --show-sdk-path|--show-sdk-version|--show-sdk-platform-path|--show-sdk-build-version|--show-sdk-platform-version) item="$1"; shift ;;
    -f|--find) shift; command -v "$1" || command -v "$1-20"; exit $? ;;
    -*) shift ;;
    *) exec "$@" ;;
  esac
done
case "$sdk" in iphoneos*) dir=/build/sdk/iPhoneOS.sdk ;; iphonesimulator*) dir=/build/sdk/iPhoneSimulator.sdk ;; *) dir=/ ;; esac
case "$item" in
  --show-sdk-path) echo "$dir" ;;
  --show-sdk-platform-path) echo "$(dirname "$dir")" ;;
  --show-sdk-version|--show-sdk-platform-version) [ "$dir" = / ] && echo 13.5 || python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['Version'])" "$dir/SDKSettings.json" ;;
  --show-sdk-build-version) echo 27B52 ;;
esac
