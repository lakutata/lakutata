#!/bin/sh
# The compilers of the host tools on Linux: the flags of macOS gyp gives them left out
filtered=""
skip=0
for arg in "$@"; do
  if [ $skip = 1 ]; then skip=0; continue; fi
  case "$arg" in
    -arch|-isysroot|-framework|-install_name|-compatibility_version|-current_version) skip=1 ;;
    -mmacosx-version-min=*|-stdlib=libc++|-fasm-blocks|-mpascal-strings|-Wl,-search_paths_first|-Wl,-dead_strip|-gdwarf-2|-fno-asm-blocks) ;;
    *) filtered="$filtered $(printf '%s' "$arg" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")" ;;
  esac
done
eval exec "$HOST_TOOL" $filtered
