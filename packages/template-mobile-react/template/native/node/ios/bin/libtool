#!/bin/sh
# libtool -static on Linux: the output (-o) and the objects only; the archives of the iOS objects (Mach-O) made by
# llvm-libtool-darwin, the ones of the host tools (ELF) by llvm-ar
out=""; prev=""; objects=""
for arg in "$@"; do
  if [ "$prev" = "-o" ]; then out="$arg"
  else case "$arg" in *.o) objects="$objects $arg" ;; esac
  fi
  prev="$arg"
done
[ -n "$out" ] || { echo "libtool: no output (-o)" >&2; exit 1; }
rm -f "$out"
first=$(echo $objects | cut -d' ' -f1)
if [ -n "$first" ] && [ "$(head -c 4 "$first" | od -An -tx1 | tr -d ' \n')" = "7f454c46" ]; then
  exec llvm-ar-20 rcs "$out" $objects
fi
exec llvm-libtool-darwin-20 -static -o "$out" $objects
