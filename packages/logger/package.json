{
  "name": "@lakutata/logger",
  "version": "3.1.5",
  "description": "The logger component of the lakutata framework: pino's JSON lines or readable colored lines, to stdout or any stream.",
  "keywords": [
    "lakutata",
    "logger",
    "logging",
    "pino",
    "json",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/logger",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/logger"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Logger.js",
  "types": "./dist/cjs/exports/Logger.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Logger.d.ts",
        "default": "./dist/esm/exports/Logger.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Logger.d.ts",
        "default": "./dist/cjs/exports/Logger.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/*.spec.js\""
  },
  "peerDependencies": {
    "@lakutata/core": "~3.1.5"
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
