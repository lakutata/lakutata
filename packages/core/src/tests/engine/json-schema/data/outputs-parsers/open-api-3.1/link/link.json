{
  "$ref": "#/components/schemas/person",
  "schemas": {
    "unit": {
      "type": "object",
      "properties": {
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 200
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "unit"
      ],
      "additionalProperties": false
    },
    "unifiedString": {
      "type": "string",
      "minLength": 1
    },
    "person": {
      "type": "object",
      "properties": {
        "genderSpecific": {
          "type": [
            "array",
            "boolean",
            "number",
            "object",
            "string",
            "null"
          ],
          "anyOf": [
            {
              "enum": [
                0,
                1,
                2
              ]
            },
            {
              "$ref": "#/components/schemas/unifiedString"
            }
          ]
        },
        "height": {
          "$ref": "#/components/schemas/unit"
        },
        "heightRank": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/unifiedString"
            },
            {
              "type": "number"
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "weight": {
          "$ref": "#/components/schemas/unit"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/person"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
