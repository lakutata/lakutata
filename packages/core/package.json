{
  "name": "@lakutata/core",
  "version": "3.1.4",
  "description": "The core of the lakutata framework: the IoC container and dependency injection, the object model with asynchronous construction, and DTO schema validation with the API of joi.",
  "keywords": [
    "lakutata",
    "ioc",
    "dependency-injection",
    "di",
    "container",
    "decorators",
    "dto",
    "validation",
    "joi",
    "typescript"
  ],
  "homepage": "https://lakutata.com/packages/core",
  "bugs": {
    "url": "https://github.com/lakutata/lakutata/issues",
    "email": "admin@lakutata.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/core"
  },
  "author": "alex.ma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/exports/Core.js",
  "types": "./dist/cjs/exports/Core.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/exports/Core.d.ts",
        "default": "./dist/esm/exports/Core.js"
      },
      "require": {
        "types": "./dist/cjs/exports/Core.d.ts",
        "default": "./dist/cjs/exports/Core.js"
      }
    },
    "./dtos": {
      "import": {
        "types": "./dist/types/exports/DTOs.d.ts",
        "default": "./dist/esm/exports/DTOs.js"
      },
      "require": {
        "types": "./dist/cjs/exports/DTOs.d.ts",
        "default": "./dist/cjs/exports/DTOs.js"
      }
    },
    "./com/logger": {
      "import": {
        "types": "./dist/types/exports/LoggerComponent.d.ts",
        "default": "./dist/esm/exports/LoggerComponent.js"
      },
      "require": {
        "types": "./dist/cjs/exports/LoggerComponent.d.ts",
        "default": "./dist/cjs/exports/LoggerComponent.js"
      }
    },
    "./decorator/asst": {
      "import": {
        "types": "./dist/types/exports/ASSTDecorators.d.ts",
        "default": "./dist/esm/exports/ASSTDecorators.js"
      },
      "require": {
        "types": "./dist/cjs/exports/ASSTDecorators.d.ts",
        "default": "./dist/cjs/exports/ASSTDecorators.js"
      }
    },
    "./decorator/di": {
      "import": {
        "types": "./dist/types/exports/DIDecorators.d.ts",
        "default": "./dist/esm/exports/DIDecorators.js"
      },
      "require": {
        "types": "./dist/cjs/exports/DIDecorators.d.ts",
        "default": "./dist/cjs/exports/DIDecorators.js"
      }
    },
    "./decorator/dto": {
      "import": {
        "types": "./dist/types/exports/DTODecorators.d.ts",
        "default": "./dist/esm/exports/DTODecorators.js"
      },
      "require": {
        "types": "./dist/cjs/exports/DTODecorators.d.ts",
        "default": "./dist/cjs/exports/DTODecorators.js"
      }
    },
    "./tsconfig.json": "./tsconfig.base.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:unit": "npm run compile && node --test \"dist/esm/tests/unit/*.spec.js\" \"dist/esm/tests/engine/**/*.spec.js\"",
    "test:fastpath": "npm run compile && node --import ./dist/esm/tests/engine/support/FastPathVerify.js --test \"dist/esm/tests/unit/*.spec.js\" \"dist/esm/tests/engine/**/*.spec.js\"",
    "test:layers": "node scripts/check-layers.mjs",
    "test:engine-types": "node scripts/check-engine-types.mjs"
  },
  "dependencies": {
    "@lakutata/utils": "3.1.1",
    "reflect-metadata": "0.2.2"
  },
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "tsconfig.base.json",
    "THIRD_PARTY_NOTICES.md"
  ]
}
