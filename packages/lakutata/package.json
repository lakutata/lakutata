    "tar-stream": "3.1.7",
    "dockerfile-ast": "0.7.1",
    "is-base64": "1.1.0",
    "strip-ansi": "7.1.2",
    "strip-bom": "5.0.0",
    "@sqltools/formatter": "^1.2.5",
    "ansis": "4.2.0",
    "@types/dockerode": "3.3.34"
  },
  "files": [
    "dist",
    "!dist/*/tests",
    "*.md",
    "LICENSE",
    "package.json",
    "tsconfig.base.json"
  ],
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "commander": "^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0",
    "@inquirer/prompts": "^7.0.0 || ^8.0.0",
    "fastify": "^5.0.0",
    "socket.io": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "@inquirer/prompts": {
      "optional": true
    },
    "fastify": {
