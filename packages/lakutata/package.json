    "@lakutata/docker": "3.1.1",
    "@lakutata/entrypoint": "3.1.1",
    "@lakutata/i18n": "3.1.1",
    "@lakutata/logger": "3.1.1",
    "@lakutata/monitor": "3.1.1",
    "@lakutata/mutex": "3.1.1",
    "@lakutata/orm": "3.1.1",
    "@lakutata/queue": "3.1.1",
    "@lakutata/security": "3.1.1",
    "@lakutata/utils": "3.1.1"
  },
  "files": [
