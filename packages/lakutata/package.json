  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json',JSON.stringify({type:'commonjs'}))\"",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:dispatch": "npm run compile && node dist/esm/tests/integration/Dispatch.contract.spec.js"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "requireCleanWorkingDir": true,
      "requireBranch": false,
      "commitMessage": "chore: release v${version}",
      "push": false
    },
    "github": {
      "release": true,
      "autoGenerate": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "author": "alex.ma",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git"
  },
  "homepage": "https://lakutata.com",
  "bugs": {
