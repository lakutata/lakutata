  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs-pkg": "node ../../scripts/package-build/cjs-package.mjs",
    "build:js": "npm run build:cjs && npm run build:esm && npm run build:cjs-pkg",
    "rebuild": "npm run clean && npm run build:js",
    "compile": "npm run rebuild",
    "test:dispatch": "npm run compile && node dist/esm/tests/integration/Dispatch.contract.spec.js",
    "test:integration": "npm run compile && node --test dist/esm/tests/integration/Integration.spec.js"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "requireCleanWorkingDir": true,
      "requireBranch": false,
      "commitMessage": "chore: release v${version}",
      "push": false
    },
    "github": {
      "release": true,
      "autoGenerate": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "author": "alex.ma",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lakutata/lakutata.git",
    "directory": "packages/lakutata"
  },
  "homepage": "https://lakutata.com",
  "bugs": {
