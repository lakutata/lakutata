{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "ESNext.Disposable"
        ],
        "declaration": true,
        "moduleDetection": "auto",
        "module": "Node16",
        "rootDir": "src",
        "moduleResolution": "Node16",
        "allowSyntheticDefaultImports": true,
        "types": [
            "reflect-metadata",
            "node"
        ],
        "jsx": "react",
        "useDefineForClassFields": false,
        "preserveConstEnums": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "outDir": "distro/src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": false,
        "strictPropertyInitialization": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "skipLibCheck": true,
        "allowArbitraryExtensions": true,
        "isolatedModules": true,
        "declarationMap": true,
        "paths": {
            "@lakutata/core": [
                "../core/dist/types/exports/Core"
            ],
            "@lakutata/core/dtos": [
                "../core/dist/types/exports/DTOs"
            ],
            "@lakutata/cache": [
                "../cache/dist/types/exports/Cache"
            ],
            "@lakutata/containerd": [
                "../containerd/dist/types/exports/Containerd"
            ],
            "@lakutata/docker": [
                "../docker/dist/types/exports/Docker"
            ],
            "@lakutata/i18n": [
                "../i18n/dist/types/exports/I18n"
            ],
            "@lakutata/i18n/middleware": [
                "../i18n/dist/types/exports/I18nMiddleware"
            ],
            "@lakutata/monitor": [
                "../monitor/dist/types/exports/Monitor"
            ],
            "@lakutata/core/com/logger": [
                "../core/dist/types/exports/LoggerComponent"
            ],
            "@lakutata/security": [
                "../security/dist/types/exports/Security"
            ],
            "@lakutata/utils": [
                "../utils/dist/types/exports/Utils"
            ],
            "@lakutata/utils/Time": [
                "../utils/dist/types/lib/Time"
            ],
            "@lakutata/utils/*": [
                "../utils/dist/types/lib/helpers/*"
            ],
            "@lakutata/core/decorator/asst": [
                "../core/dist/types/exports/ASSTDecorators"
            ],
            "@lakutata/core/decorator/di": [
                "../core/dist/types/exports/DIDecorators"
            ],
            "@lakutata/core/decorator/dto": [
                "../core/dist/types/exports/DTODecorators"
            ],
            "@lakutata/logger": [
                "../logger/dist/types/exports/Logger"
            ],
            "@lakutata/entrypoint": [
                "../entrypoint/dist/types/exports/Entrypoint"
            ],
            "@lakutata/entrypoint/decorator/ctrl": [
                "../entrypoint/dist/types/exports/CTRLDecorators"
            ],
            "@lakutata/entrypoint/adapter/express": [
                "../entrypoint/dist/types/exports/ExpressAdapter"
            ],
            "@lakutata/entrypoint/adapter/commander": [
                "../entrypoint/dist/types/exports/CommanderAdapter"
            ],
            "@lakutata/entrypoint/adapter/fastify": [
                "../entrypoint/dist/types/exports/FastifyAdapter"
            ],
            "@lakutata/entrypoint/adapter/socket.io": [
                "../entrypoint/dist/types/exports/SocketIOAdapter"
            ],
            "@lakutata/entrypoint/adapter/electron": [
                "../entrypoint/dist/types/exports/ElectronAdapter"
            ],
            "@lakutata/orm": [
                "../orm/dist/types/exports/ORM"
            ],
            "@lakutata/orm/decorator/orm": [
                "../orm/dist/types/exports/ORMDecorators"
            ],
            "@lakutata/orm/com/database": [
                "../orm/dist/types/exports/DatabaseComponent"
            ],
            "@lakutata/orm/provider/database": [
                "../orm/dist/types/exports/DatabaseProvider"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "scripts",
        "build",
        "distro",
        "publish.mjs",
        "rollup.mjs"
    ]
}
