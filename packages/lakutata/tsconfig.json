{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "ESNext.Disposable"
        ],
        "declaration": true,
        "moduleDetection": "auto",
        "module": "Node16",
        "rootDir": "src",
        "moduleResolution": "Node16",
        "allowSyntheticDefaultImports": true,
        "types": [
            "reflect-metadata",
            "node"
        ],
        "jsx": "react",
        "useDefineForClassFields": false,
        "preserveConstEnums": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "outDir": "distro/src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": false,
        "strictPropertyInitialization": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "skipLibCheck": true,
        "allowArbitraryExtensions": true,
        "isolatedModules": true,
        "declarationMap": true,
        "baseUrl": ".",
        "paths": {
            "@lakutata/core": [
                "../core/dist/types/exports/Core"
            ],
            "@lakutata/core/dtos": [
                "../core/dist/types/exports/DTOs"
            ],
            "@lakutata/core/helper": [
                "../core/dist/types/exports/Helpers"
            ],
            "@lakutata/core/internal": [
                "../core/dist/types/exports/Internal"
            ],
            "@lakutata/core/com/cacher": [
                "../core/dist/types/exports/CacherComponent"
            ],
            "@lakutata/core/com/monitor": [
                "../core/dist/types/exports/MonitorComponent"
            ],
            "@lakutata/core/com/entrypoint": [
                "../core/dist/types/exports/EntrypointComponent"
            ],
            "@lakutata/core/com/logger": [
                "../core/dist/types/exports/LoggerComponent"
            ],
            "@lakutata/security": [
                "../security/dist/types/exports/Security"
            ],
            "@lakutata/utils": [
                "../utils/dist/types/exports/Utils"
            ],
            "@lakutata/core/decorator/asst": [
                "../core/dist/types/exports/ASSTDecorators"
            ],
            "@lakutata/core/decorator/ctrl": [
                "../core/dist/types/exports/CTRLDecorators"
            ],
            "@lakutata/core/decorator/di": [
                "../core/dist/types/exports/DIDecorators"
            ],
            "@lakutata/core/decorator/dto": [
                "../core/dist/types/exports/DTODecorators"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "scripts",
        "build",
        "distro",
        "publish.mjs",
        "rollup.mjs"
    ]
}
