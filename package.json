{
  "name": "lakutata-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run compile -w packages/lakutata",
    "test:unit": "npm run test:unit -w packages/lakutata",
    "test:dispatch": "npm run test:dispatch -w packages/lakutata",
    "test:types": "npm run build && tsc --noEmit -p consumer-fixture/tsconfig.json"
  },
  "devDependencies": {
    "lerna": "^8.1.0"
  }
}
